# Copy to .env on the VPS (chmod 600). DO NOT commit real secrets.
# Phase 3 — production template

# --- Domain ---
DOMAIN=yourdomain.com
CADDY_ACME_EMAIL=admin@yourdomain.com

# --- Postgres (Docker service: db) — strong password required ---
POSTGRES_USER=geouser
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_32
POSTGRES_DB=geo_platform
# Do NOT publish Postgres in prod (docker-compose.prod.yml resets ports)

DATABASE_URL=postgresql://geouser:REPLACE_WITH_OPENSSL_RAND_BASE64_32@db:5432/geo_platform

# --- Payload / API ---
NODE_ENV=production
PAYLOAD_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_MIN_32_CHARS
API_PORT=3001
API_BASE_URL=https://api.yourdomain.com
PORT=3001
CORS_ORIGINS=https://map.yourdomain.com
ADMIN_TOKEN=REPLACE_ME

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Frontend (build-time NEXT_PUBLIC_* must match public HTTPS API) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors © CARTO"
NEXT_PUBLIC_MAP_DEFAULT_LAT=21.0285
NEXT_PUBLIC_MAP_DEFAULT_LNG=105.8542
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# --- Geocoding FREE ---
GEOCODER_PRIMARY=photon
PHOTON_BASE_URL=https://photon.komoot.io/api/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="MapPlatform-VinSmartFuture/1.0 (contact: admin@yourdomain.com)"
NOMINATIM_MIN_INTERVAL_MS=1100

# --- Crawler ---
CRAWL_SCHEDULE=0 2 * * *
CRAWL_TIMEZONE=Asia/Ho_Chi_Minh
CRAWL_REQUEST_TIMEOUT_MS=30000
CRAWL_MAX_RETRIES=3
CRAWL_ON_START=0
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRROR_URL=https://overpass.kumi.systems/api/interpreter

# --- Optional local LLM (usually off in prod VPS) ---
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.2
