# Copy to .env and fill in real values. DO NOT commit .env.
# MVP: KHÔNG bắt buộc Mapbox / Goong / Geoapify / Google (tránh mất phí).
# Xem docs/09-free-apis-and-urls.md

# --- Postgres (Docker service: db) ---
POSTGRES_USER=geouser
POSTGRES_PASSWORD=geopass
POSTGRES_DB=geo_platform
POSTGRES_PORT=5433

DATABASE_URL=postgresql://geouser:geopass@127.0.0.1:5433/geo_platform
DATABASE_URL_TEST=postgresql://geouser:geopass@127.0.0.1:5433/geo_platform_test

# --- Monolith app (Docker service: app) — Admin + map + API ---
NODE_ENV=development
PAYLOAD_SECRET=change-me-payload-secret-min-32-characters-long
APP_PORT=3001
API_PORT=3001
API_BASE_URL=http://localhost:3001
PORT=3001
# Same-origin monolith: leave empty. CORS only needed for legacy-web profile.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3000
ADMIN_TOKEN=change-me-in-production

# Payload Jobs autoRun (required for scheduleCrawl every 6h). Set 0 only on serverless.
PAYLOAD_JOBS_AUTORUN=1
# Auto crawl cron (Payload task scheduleCrawl). Default: every 6 hours at :00
CRAWL_AUTO_CRON=0 */6 * * *
# Set 0 to pause auto schedule without stopping the app
CRAWL_AUTO_SCHEDULE=1
# per_city (default): 1 Crawl Job / city each tick, run sequentially
# round_robin: 1 city / tick (rotate by UTC hour) — pair with hourly cron
# all: legacy single job with every enabled city
CRAWL_SCHEDULE_MODE=per_city
# How many crawl queue tasks autoRun starts per minute (keep 1 to protect Overpass)
CRAWL_QUEUE_LIMIT=1
# First Admin boot needs push to create cms_* tables. Set 0 only after schema exists.
PAYLOAD_PUSH=1
# Payload tables live in this Postgres schema (not public) to avoid PostGIS rename prompts
PAYLOAD_SCHEMA=payload
# docker | python — how invokeCrawl / Admin Jobs spawn scheduler.run_once
CRAWL_EXEC=docker
# Legacy Python APScheduler daemon (compose service crawler). Prefer Payload 6h schedule.
CRAWL_ENABLE_SCHEDULER=0

# --- Frontend (same app; NEXT_PUBLIC_* baked at build for Docker) ---
# Empty = relative /api on same origin
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors © CARTO"
NEXT_PUBLIC_MAP_DEFAULT_LAT=21.0285
NEXT_PUBLIC_MAP_DEFAULT_LNG=105.8542
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# Legacy separate web (profile legacy-web only)
WEB_PORT=3002

# --- Geocoding FREE (crawler) ---
GEOCODER_PRIMARY=photon
PHOTON_BASE_URL=https://photon.komoot.io/api/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="MapPlatform-VinSmartFuture/1.0 (contact: your-email@example.com)"
NOMINATIM_MIN_INTERVAL_MS=1100

# --- Crawler ---
CRAWL_SCHEDULE=0 2 * * *
CRAWL_TIMEZONE=Asia/Ho_Chi_Minh
CRAWL_REQUEST_TIMEOUT_MS=30000
CRAWL_MAX_RETRIES=3
CRAWL_CITIES=hanoi,hcm,danang
CRAWL_SOURCES=vinfast,charging,parking,rescue,gas,university,hospital,pharmacy,atm,bank,police,fire_station,school,marketplace,bus_stop,subway_station,park,tourist_attraction
CRAWL_CITY=hanoi
PAYLOAD_API_URL=http://app:3001
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIRROR_URL=https://overpass.kumi.systems/api/interpreter

# --- Rate limiting (API) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Phase 2 Decision Engine ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=8000
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=6000

ROUTING_PROVIDER=auto
OSRM_BASE_URL=https://router.project-osrm.org
# Comma-separated mirrors (preferred). FOSSGIS uses /routed-car|/routed-foot|/routed-bike prefixes.
# OSRM_BASE_URLS=https://router.project-osrm.org,https://routing.openstreetmap.de
# ORS_API_KEY=   # free key from openrouteservice.org — walk/bike + alternatives
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OTP_BASE_URL=http://127.0.0.1:8080
# OTP_CITIES=hanoi

# --- Auto crawl (Payload Jobs) ---
# CRAWL_AUTO_CRON=0 */6 * * *
# CRAWL_AUTO_SCHEDULE=0
# Transit stops only (HN + HCM), separate Crawl Job per city, every 4h:
# CRAWL_TRANSIT_AUTO_CRON=0 */4 * * *
# CRAWL_TRANSIT_CITIES=hanoi,hcm
# CRAWL_TRANSIT_AUTO_SCHEDULE=0

# --- Ops alerts ---
# ALERT_WEBHOOK_URL=
# ALERT_LOOKBACK_HOURS=24
