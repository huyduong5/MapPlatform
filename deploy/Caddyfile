# Đổi yourdomain.com thành domain thật trước khi deploy.
# DNS A record trỏ về IP VPS. Monolith: một origin cho map + admin + API.

{
	email {$CADDY_ACME_EMAIL}
}

# Primary: map + /admin + /api on one host
map.{$DOMAIN:yourdomain.com} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:3001
}

# Optional alias — same monolith (backward-compatible hostname)
api.{$DOMAIN:yourdomain.com} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:3001
}
